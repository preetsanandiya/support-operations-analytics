table dim_date
	lineageTag: a9de0f8e-faa4-54bc-8315-82be8935feb3
	dataCategory: Time
	column Date
		dataType: dateTime
		isKey
		formatString: yyyy-mm-dd
		lineageTag: effb4091-3277-5f77-b60a-4a905942566c
		summarizeBy: none
		sourceColumn: Date

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column 'Month Start'
		dataType: dateTime
		formatString: mmm yyyy
		lineageTag: 8346a072-d3ee-5c51-a12c-a1ca97f0172c
		summarizeBy: none
		sourceColumn: Month Start

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column 'Month Key'
		dataType: int64
		formatString: 0
		isHidden
		lineageTag: 6183de86-031e-514a-869a-5dc8b0310919
		summarizeBy: none
		sourceColumn: Month Key

		annotation SummarizationSetBy = Automatic

	column Month
		dataType: string
		lineageTag: d0827b10-cdc2-5cb3-8013-7b5fd8b296e6
		summarizeBy: none
		sourceColumn: Month
		sortByColumn: 'Month Key'

		annotation SummarizationSetBy = Automatic

	partition dim_date = m
		mode: import
		source =
				let
				    Start = #date(2025, 10, 1),
				    End = #date(2026, 9, 30),
				    Dates = List.Dates(Start, Duration.Days(End - Start) + 1, #duration(1, 0, 0, 0)),
				    Base = Table.FromList(Dates, Splitter.SplitByNothing(), {"Date"}),
				    Typed = Table.TransformColumnTypes(Base, {{"Date", type date}}),
				    MonthStart = Table.AddColumn(Typed, "Month Start", each Date.StartOfMonth([Date]), type date),
				    MonthKey = Table.AddColumn(MonthStart, "Month Key", each Date.Year([Date]) * 100 + Date.Month([Date]), Int64.Type),
				    Month = Table.AddColumn(MonthKey, "Month", each Date.ToText([Date], "MMM yyyy", "en-US"), type text)
				in
				    Month

	annotation PBI_ResultType = Table

