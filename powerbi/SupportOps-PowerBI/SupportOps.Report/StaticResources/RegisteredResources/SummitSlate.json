              "solid": {
                "color": "#DDE3EA"
              }
            },
            "radius": 10
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "preset": "Custom",
            "shadowSpread": 1,
            "shadowBlur": 6,
            "angle": 90,
            "shadowDistance": 2,
            "transparency": 88,
            "color": {
              "solid": {
                "color": "#0B2239"
              }
            },
            "position": "Outer"
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F4F6F9"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F4F6F9"
              }
            }
          }
        ]
      }
